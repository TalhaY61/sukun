<Window x:Class="Sukun.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sukun.Windows"
 Title="Sükûn" Width="456" Height="602" MinWidth="420" MinHeight="490" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}" WindowStartupLocation="Manual" ResizeMode="NoResize" UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="12">
 <Grid x:Name="RootPanel" Margin="16,12,16,10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,8"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Brand.Mark}" Fill="{DynamicResource Accent}" Width="27" Height="27" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Sükûn" FontSize="22" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{DynamicResource Tagline}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><local:SearchComboBox x:Name="LanguageBox" Width="62" Height="30" Margin="0,0,6,0" AutomationProperties.Name="{DynamicResource Language}" SelectionChanged="LanguageChanged"/><local:SearchComboBox x:Name="ThemeBox" Width="84" Height="30" AutomationProperties.Name="{DynamicResource Appearance}" SelectionChanged="ThemeChanged"/></StackPanel></Grid>
  <StackPanel Grid.Row="1" Margin="0,0,0,8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="AutomationToggle" Style="{StaticResource AutomationSwitch}" Content="{DynamicResource AutomationTitle}" Click="ToggleAutomation" IsEnabled="False" AutomationProperties.Name="{DynamicResource AutomationTitle}"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource Muted}" Margin="0,0,6,0"/><TextBlock x:Name="StatusLabel" Text="{DynamicResource Off}" Style="{StaticResource Caption}"/></StackPanel></Grid>
   <Grid x:Name="PrayerSummary" Margin="0,5,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource NextPrayerCaption}" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="NextPrayerText" Text="{DynamicResource ChooseLocationTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,1,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{DynamicResource RemainingCaption}" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right"/><TextBlock x:Name="NextTimeText" FontSize="17" Foreground="{DynamicResource Secondary}" Typography.NumeralAlignment="Tabular" Margin="10,1,0,0"/></StackPanel></Grid>
   <TextBlock x:Name="StatusDetail" Text="{DynamicResource InitialTimes}" Style="{StaticResource Caption}"/>
   <Button x:Name="ChooseLocationButton" Content="{DynamicResource ChooseLocationAction}" Click="BeginLocationSetup" HorizontalAlignment="Left" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentStroke}" FontWeight="SemiBold" Padding="12,6" Margin="0,7,0,2" Visibility="Collapsed"/>
   <Button x:Name="CancelButton" Content="{DynamicResource CancelResume}" Click="CancelResume" Visibility="Collapsed" HorizontalAlignment="Left" FontSize="11" Margin="0,5,0,0"/>
  </StackPanel>
  <StackPanel x:Name="PrayerTimesPanel" Grid.Row="2" Margin="0,0,0,8">
   <Grid Margin="0,0,0,6"><TextBlock Text="{DynamicResource TodayTimes}" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="TodayLabel" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
   <UniformGrid Columns="6" Margin="-2,0,-2,0">
    <CheckBox x:Name="FajrCheck" Style="{StaticResource PrayerChoice}" Tag="Fajr" Click="PrayerChanged" AutomationProperties.Name="{DynamicResource Fajr}" ToolTip="{DynamicResource FajrHint}"><StackPanel><TextBlock Text="{DynamicResource Fajr}" FontSize="10" HorizontalAlignment="Center"/><TextBlock x:Name="FajrTime" Text="--:--" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/></StackPanel></CheckBox>
    <Border Background="{DynamicResource Input}" CornerRadius="5" Margin="2,0" Padding="0,3,0,7" Opacity=".65" ToolTip="{DynamicResource SunriseHint}"><StackPanel VerticalAlignment="Center"><Border Height="12" Margin="0,0,0,1"/><TextBlock Text="{DynamicResource Sunrise}" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/><TextBlock x:Name="SunriseTime" Text="--:--" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/></StackPanel></Border>
    <CheckBox x:Name="DhuhrCheck" Style="{StaticResource PrayerChoice}" Tag="Dhuhr" Click="PrayerChanged" AutomationProperties.Name="{DynamicResource Dhuhr}"><StackPanel><TextBlock Text="{DynamicResource Dhuhr}" FontSize="10" HorizontalAlignment="Center"/><TextBlock x:Name="DhuhrTime" Text="--:--" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/></StackPanel></CheckBox>
    <CheckBox x:Name="AsrCheck" Style="{StaticResource PrayerChoice}" Tag="Asr" Click="PrayerChanged" AutomationProperties.Name="{DynamicResource Asr}"><StackPanel><TextBlock Text="{DynamicResource Asr}" FontSize="10" HorizontalAlignment="Center"/><TextBlock x:Name="AsrTime" Text="--:--" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/></StackPanel></CheckBox>
    <CheckBox x:Name="MaghribCheck" Style="{StaticResource PrayerChoice}" Tag="Maghrib" Click="PrayerChanged" AutomationProperties.Name="{DynamicResource Maghrib}"><StackPanel><TextBlock Text="{DynamicResource Maghrib}" FontSize="10" HorizontalAlignment="Center"/><TextBlock x:Name="MaghribTime" Text="--:--" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/></StackPanel></CheckBox>
    <CheckBox x:Name="IshaCheck" Style="{StaticResource PrayerChoice}" Tag="Isha" Click="PrayerChanged" AutomationProperties.Name="{DynamicResource Isha}"><StackPanel><TextBlock Text="{DynamicResource Isha}" FontSize="10" HorizontalAlignment="Center"/><TextBlock x:Name="IshaTime" Text="--:--" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/></StackPanel></CheckBox>
   </UniformGrid>
   <TextBlock Text="{DynamicResource ChoosePrayers}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
  </StackPanel>
  <ScrollViewer Style="{StaticResource ThinScrollViewer}" x:Name="RootScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,2,0">
   <StackPanel>
    <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,8"/>
    <Grid Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Fluent.Location}" Style="{StaticResource FluentIcon}" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Location}" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="LocationSummary" Style="{StaticResource Caption}" Margin="72,0,54,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Visibility="Collapsed"/><Button x:Name="ChangeLocationButton" Content="{DynamicResource Change}" HorizontalAlignment="Right" Click="EditLocation" MinHeight="18" Padding="5,0" BorderBrush="Transparent" FontSize="11"/></Grid>
    <Grid x:Name="LocationEditor"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><local:SearchComboBox x:Name="ProvinceBox" SearchEnabled="True" Tag="{DynamicResource ChooseProvince}" AutomationProperties.Name="{DynamicResource ProvinceSearch}" SelectionChanged="ProvinceChanged"/><local:SearchComboBox x:Name="PlaceBox" SearchEnabled="True" Grid.Column="2" Tag="{DynamicResource ChoosePlace}" AutomationProperties.Name="{DynamicResource DistrictSearch}" SelectionChanged="PlaceChanged"/></Grid>
    <Grid Margin="0,2,0,6"><TextBlock x:Name="CoverageText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,48,0"/><Button x:Name="RefreshButton" Content="{DynamicResource Refresh}" Click="RefreshTimes" HorizontalAlignment="Right" MinHeight="20" Padding="5,1" BorderBrush="Transparent" FontSize="11"/></Grid>
    <Grid Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Fluent.Media}" Style="{StaticResource FluentIcon}" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource MediaSource}" FontWeight="SemiBold"/></StackPanel><Button Content="{DynamicResource Scan}" Click="ScanPlayers" HorizontalAlignment="Right" MinHeight="18" Padding="5,0" BorderBrush="Transparent" FontSize="11"/></Grid>
    <local:SearchComboBox x:Name="PlayerBox" SearchEnabled="False" Tag="{DynamicResource SearchMedia}" SelectionChanged="PlayerChanged" AutomationProperties.Name="{DynamicResource MediaSearchLabel}">
     <local:SearchComboBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding Tooltip}"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Secondary}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel></DataTemplate></local:SearchComboBox.ItemTemplate>
    </local:SearchComboBox>
    <TextBlock x:Name="PlayerDetail" Style="{StaticResource Caption}" Margin="0,4,0,8" MaxHeight="30"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource BeforePrayer}" Style="{StaticResource Caption}" Margin="0,0,0,3"/><local:SearchComboBox x:Name="BeforeBox" SelectionChanged="TimingChanged" AutomationProperties.Name="{DynamicResource BeforePrayerLabel}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource AfterPrayer}" Style="{StaticResource Caption}" Margin="0,0,0,3"/><local:SearchComboBox x:Name="AfterBox" SelectionChanged="TimingChanged" AutomationProperties.Name="{DynamicResource AfterPrayerLabel}"/></StackPanel></Grid>
    <Expander Expanded="DetailsExpanded" Collapsed="DetailsCollapsed" Margin="0,4,0,0">
     <Expander.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Fluent.Settings}" Style="{StaticResource FluentIcon}" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Advanced}" FontWeight="SemiBold"/></StackPanel></Expander.Header>
     <StackPanel>
      <CheckBox x:Name="StartupCheck" Content="{DynamicResource Startup}" Click="StartupChanged"/>
      <CheckBox x:Name="UpdateCheck" Content="{DynamicResource RefreshTimes}" Click="UpdateChanged"/>
      <TextBlock x:Name="RunningVersionText" Style="{StaticResource Caption}" Margin="0,4,0,3"/>
      <TextBlock Text="{DynamicResource PortableUpdateHelp}" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
      <CheckBox x:Name="SoftwareUpdatesCheck" Content="{DynamicResource CheckUpdates}" Click="SoftwareUpdatesChanged" ToolTip="{DynamicResource UpdateOptInHint}"/>
      <TextBlock Text="{DynamicResource OfflineHint}" Style="{StaticResource Caption}" Margin="0,5,0,10"/>
      <StackPanel x:Name="DeveloperTools" Visibility="Collapsed">
      <Button x:Name="TestMediaButton" Content="{DynamicResource TestMedia}" Click="StartMediaTest" HorizontalAlignment="Left"/>
      <TextBlock Text="{DynamicResource TestHint}" Style="{StaticResource Caption}" Margin="0,5,0,4"/>
      <TextBox x:Name="TestDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Input}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Stroke}" Padding="7" FontSize="11" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button x:Name="CancelTestButton" Content="{DynamicResource CancelTest}" Click="CancelMediaTest" Visibility="Collapsed" FontSize="11" Margin="0,0,8,0"/><Button Content="{DynamicResource OpenLog}" Click="OpenDiagnostics" FontSize="11"/></StackPanel>
      </StackPanel>
     </StackPanel>
    </Expander>
    <TextBlock x:Name="NoticeText" Foreground="{DynamicResource Warning}" FontSize="11" Margin="0,5,0,3" Visibility="Collapsed"/>
   </StackPanel>
  </ScrollViewer>
  <UniformGrid Grid.Row="4" Columns="4" Margin="-3,8,-3,0">
   <Button x:Name="GitHubButton" Click="OpenProject" Margin="3,0" Padding="4,8" Background="{DynamicResource Surface}" ToolTip="{DynamicResource GitHubHint}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Fluent.Code}" Style="{StaticResource FluentIcon}" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource GitHub}" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
   <Button x:Name="FeedbackButton" Click="OpenFeedback" Margin="3,0" Padding="4,8" Background="{DynamicResource Surface}" ToolTip="{DynamicResource ReportIssueHint}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Fluent.Bug}" Style="{StaticResource FluentIcon}" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource ReportIssue}" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
   <Button x:Name="SoftwareUpdateButton" Click="UpdateApplication" Margin="3,0" Padding="4,8" Background="{DynamicResource Surface}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Fluent.Sync}" Style="{StaticResource FluentIcon}" Margin="0,0,5,0"/><TextBlock x:Name="SoftwareUpdateLabel" Text="{DynamicResource Update}" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
   <Button x:Name="QuitButton" Click="QuitApplication" Margin="3,0" Padding="4,8" Background="{DynamicResource Surface}" ToolTip="{DynamicResource QuitHint}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Fluent.Power}" Style="{StaticResource FluentIcon}" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource Quit}" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
  </UniformGrid>
 </Grid>
</Window>
